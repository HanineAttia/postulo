<!doctype html>
<html lang="{{ d.lang }}">
<head>
<meta charset="utf-8">
<title>{{ d.meta_title }}</title>
<meta name="author" content="{{ d.name }}">
<style>
{% for family, files in fonts.items() %}
{% for weight, style, url in files %}
@font-face { font-family: "{{ family }}"; src: url("{{ url }}") format("truetype"); font-weight: {{ weight }}; font-style: {{ style }}; }
{% endfor %}
{% endfor %}
{% block page %}@page { size: {{ "A4" if L.paper == "a4" else "letter" }}; margin: {{ L.margin_y }}mm {{ L.margin_x }}mm; }{% endblock %}
* { box-sizing: border-box; }
html, body { margin: 0; padding: 0; }
body {
  font-family: "{{ L.font }}", sans-serif;
  font-size: {{ L.size }}pt;
  color: {{ L.ink }};
  line-height: {{ 0.73 + L.leading }};
  text-align: left;
  /* ATS rules (SPEC 7.2): no ligatures, no hyphenation. */
  font-variant-ligatures: none;
  font-feature-settings: "liga" 0, "clig" 0, "dlig" 0, "hlig" 0;
  hyphens: none;
}
p { margin: 0; }
a { color: {{ L.accent }}; text-decoration: {{ "underline" if L.template == "classic" else "none" }}; }
.contact span, .nobreak { white-space: nowrap; }
.sep { margin: 0 0.45em; }
{% block style %}{% endblock %}
</style>
</head>
<body>
{% block content %}{% endblock %}
</body>
</html>
